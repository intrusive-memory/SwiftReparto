# Swift Package Manager build products
.build/

# Xcode's per-package state. Currently only empty directories, so it does not
# show in `git status` — it fills the moment anyone opens the package in Xcode.
.swiftpm/

# Xcode build intermediates
DerivedData/
*.xcuserstate
xcuserdata/

# Code coverage profiles
*.profraw
*.profdata

# `make release` / `make install` drop the built CLI here.
/bin/

# macOS
.DS_Store

# NOTE: Package.resolved is deliberately TRACKED, reversing the org's
# library-package convention (see `spm-package-audit`). This package ships an
# executable, and a binary built by CI from an unpinned dependency graph is not
# reproducible. SwiftProyecto, which also ships a CLI, tracks it for the same
# reason. Do not add it here.

# graphify codemap: commit the portable graph artifacts, ignore machine-specific
# markers (absolute paths), the regenerable cache, and the absolute-path manifest.
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_detect.json
graphify-out/cache/
graphify-out/manifest.json
# graphify's dated backup dirs duplicate the graph files — including the
# absolute-path manifest.json — so they are scratch too.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
